# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Sin DATABASE_URL se usa SQLite local. Para PostgreSQL local:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/cintac

# Administrador inicial (lo crea el comando crear_admin_inicial; deberá cambiar la clave al ingresar)
ADMIN_USERNAME=admin_cintac
ADMIN_PASSWORD=Temporal#2026
ADMIN_NOMBRE=Administrador CINTAC

# Si es False, superar 25 t por contenedor solo muestra una advertencia en vez de bloquear
COTIZADOR_BLOQUEAR_EXCESO_PESO=True
# Minutos de inactividad antes de cerrar la sesión
SESSION_COOKIE_AGE=1800
